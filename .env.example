POSTGRES_USER=priorizai_user
POSTGRES_PASSWORD=priorizai_password
POSTGRES_DB=priorizai_db
POSTGRES_PORT=5432

BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Servicio de modelos externo. Con una URL aca el backend pide las predicciones
# por HTTP y no necesita torch ni la carpeta models/ local. Vacia, los modelos
# corren dentro del backend como hasta ahora.
# La URL del despliegue no va en el repositorio: pedirsela al equipo.
MODEL_SERVICE_URL=
# El servicio escala a cero: la primera peticion tras un rato inactivo paga el
# arranque en frio, que es de minutos. No bajar este valor.
MODEL_SERVICE_TIMEOUT=300
# Clave que exige el servicio en la cabecera X-API-Key. Vacia = no se manda.
# Es un secreto: no ponerla aca, va en el .env local, que no se versiona.
MODEL_SERVICE_API_KEY=
